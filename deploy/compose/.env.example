# deploy/compose/.env.example — 复制为同目录 `.env`（权限 600，已在 .gitignore；本文件只放键名与占位）。
# 用法：make dev-up / docker compose -f docker-compose.{dev,prod}.yml --env-file .env ...

# ── dev（本机）──────────────────────────────────────────────
# 本机 docker.io 直连 Bad Gateway（2026-10-13 实测）→ 用 daocloud 镜像源覆盖：
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.13-slim
# GO_IMAGE=docker.m.daocloud.io/library/golang:1.27-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16   # alembic 要 vector 扩展
# RABBITMQ_IMAGE=docker.m.daocloud.io/library/rabbitmq:3-management
# POSTGRES_PASSWORD=closenai-dev-only   # dev 明示口令；prod 不许复用这行
# go-core 镜像内 go mod download 走的也是上游：本机 proxy.golang.org 中途 EOF
# （2026-10-18 实测）→ GOPROXY=https://goproxy.cn,direct 覆盖，默认仍是上游。
# GOPROXY=https://goproxy.cn,direct
# pip 同理：容器内 pypi.org 直连会卡死（2026-10-18 实测）→ 覆盖为镜像站
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# AMQP 拓扑由 Go 独占声明；要在本机把 worker 管道起通，显式开这把刀（默认 0＝现网口径）：
# CLOSEN_OUTBOX_WORKER=1

JWT_SECRET=<openssl rand -hex 32>
CRON_SECRET=<openssl rand -hex 16>

# ── prod（VPS，T0-01b 验收随部署解锁）───────────────────────
# PY_IMAGE=closenai-py-api:<发布 tag>
# GO_IMAGE_TAG=closenai-go-api:<发布 tag>
# DATABASE_URL=postgresql://user:pass@aws-0-x.pooler.supabase.com:6543/postgres?sslmode=require
# RABBITMQ_USER= / RABBITMQ_PASSWORD=<宿主生成，不入库>
# CLOSENAI_DOMAIN=api.closenai.app
# 灰度/开关键一律不在这里偷偷放量：CLOSEN_MQ_WORKER / CLOSEN_OUTBOX_WORKER /
# CLOSEN_CANDIDATE_WORKER 默认 0，放行是现网决策（R5/R7 口径）。
# QSTASH_TOKEN= POSTHOG_API_KEY= 可选，空＝对应链路 no-op。
