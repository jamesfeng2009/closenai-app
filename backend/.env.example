# ============================================================
# ClosenAI 后端环境变量模板
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会提交。
# ============================================================

# --- 数据库（Supabase）---
# 从 Supabase Dashboard → Project Settings → Database → Connection string
# Vercel Serverless 使用 Transaction pooler（端口 6543）连接串
DATABASE_URL=postgresql+psycopg://postgres.xxxxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- 运行环境 ---
# development（默认）：允许 X-User-Id 设备身份透传（开发联调用）
# production：强制 JWT Bearer 鉴权，X-User-Id 一律忽略（上线必须设置！）
ENVIRONMENT=development

# --- 认证（自建 JWT）---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# --- LLM（多 Provider）---
# 可选：dashscope（通义千问，默认） / doubao（豆包） / gemini / openai
LLM_PROVIDER=dashscope

# DashScope（通义千问）— 推荐，国产性价比高
# https://bailian.console.aliyun.com/ → API-KEY
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-flash
DASHSCOPE_LITE_MODEL=qwen3-flash-lite

# 豆包（火山方舟）
# DOUBAO_API_KEY=
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_MODEL=
# DOUBAO_LITE_MODEL=

# Gemini（备用）
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash-lite

# --- Redis（Upstash）---
# https://console.upstash.com/redis
REDIS_URL=your-redis-url
REDIS_TOKEN=your-redis-token

# --- QStash（Upstash）---
# https://console.upstash.com/qstash
QSTASH_TOKEN=your-qstash-token
QSTASH_URL=https://qstash.upstash.io
# QStash 回调验签 Signing Keys（QStash 控制台 → Signing Keys；支持密钥轮换）
QSTASH_CURRENT_SIGNING_KEY=your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key
# 后端公网基础 URL（QStash 回调 /api/v1/cron/process-user 的目标地址）
BACKEND_BASE_URL=https://your-app.vercel.app

# --- 推送（APNs / FCM）---
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
# FCM legacy server key（已废弃，仅作 HTTP v1 未配置时的回退）
FCM_SERVER_KEY=
# FCM HTTP v1（推荐）：service account JSON 单行内容或 JSON 文件路径
# 获取：Firebase Console → Project Settings → Service accounts → Generate new private key
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com",...}
FCM_SERVICE_ACCOUNT_JSON=

# --- IAP（App Store）---
APP_STORE_SHARED_SECRET=
APP_STORE_ENV=sandbox
# 试用到期前提醒提前量（小时）
TRIAL_REMIND_HOURS=24

# --- 分享落地页（P1-F04：他人点击分享链接 → App Store 下载页）---
APP_STORE_URL=https://apps.apple.com/app/closenai/id6740000000

# --- 定时任务 ---
CRON_SECRET=change-me-cron-secret