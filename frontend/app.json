{
  "expo": {
    "name": "ClosenAI",
    "slug": "closenai",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "closenai",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#050508"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.closenai.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.closenai.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "react-native-iap",
      "expo-apple-authentication",
      "expo-notifications"
    ]
  }
}
